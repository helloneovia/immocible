# Database
DATABASE_URL="postgresql://user:password@localhost:5432/immocible"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production"

# Email Configuration (Optional)
EMAIL_SERVER="smtp://user:password@smtp.example.com:587"
EMAIL_FROM="noreply@immocible.com"

# Application Settings
NODE_ENV="development"

# URL publique du site (utilisée pour le SEO : sitemap, robots, canonical, Open Graph)
NEXT_PUBLIC_SITE_URL="https://immocible.com"

# Blog (widget Adneo) — identifiant du site
NEXT_PUBLIC_ADNEO_WEBSITE_ID="cmpxtvs0500003aleux4hn8nv"

# Payment
STRIPE_SECRET_KEY="sk_test_..."
# Secret de signature du webhook Stripe (dashboard Stripe > Webhooks).
# Endpoint à créer : https://<domaine>/api/payment/webhook (event checkout.session.completed)
STRIPE_WEBHOOK_SECRET="whsec_..."
